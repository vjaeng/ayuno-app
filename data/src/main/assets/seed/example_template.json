{
  "name": "Ejemplo (sin valores clínicos)",
  "target_hours": 36.0,
  "milestone_hours": [12.0, 24.0],
  "stages": [
    { "kind": "preparation", "duration_value": 1.0, "duration_unit": "days" },
    { "kind": "refeed", "duration_value": 4.0, "duration_unit": "hours" },
    { "kind": "post", "duration_value": 2.0, "duration_unit": "days" }
  ],
  "metrics": [
    { "metric_type_code": "glucose", "schedules": [ { "stage_kind": "fast", "time_of_day": "07:00" }, { "stage_kind": "fast", "time_of_day": "19:00" } ] },
    { "metric_type_code": "weight", "schedules": [ { "stage_kind": "fast", "time_of_day": "07:00" }, { "stage_kind": "post", "time_of_day": "07:00" } ] },
    { "metric_type_code": "blood_pressure", "schedules": [ { "stage_kind": "fast", "time_of_day": "07:00" } ] }
  ],
  "rules": [
    {
      "name": "Glucosa baja (pon tu umbral)", "active": false, "condition_kind": "metric_below", "metric_type_code": "glucose",
      "level": "alert", "message": "Escribe aquí qué harás cuando se cumpla esta regla.", "action": "offer_end"
    },
    {
      "name": "Algo no va bien", "active": true, "condition_kind": "manual", "metric_type_code": null,
      "level": "alert", "message": "Escribe aquí qué harás si algo no va bien.", "action": "offer_end"
    }
  ]
}
